# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
ENV/
.venv/
.ENV/

# VS Code settings
.vscode/

# Environment variables
*.env
*.env.*

# Logs and local databases
*.log
*.sqlite3
*.db

# OS-specific files
.DS_Store
Thumbs.db

# Python packaging
build/
dist/
*.egg-info/

# Dependency files
pip-wheel-metadata/
__pypackages__/

# Ignore node_modules if using frontend tools
node_modules/

# Ignore compiled files from other languages (just in case)
*.class
*.jar
*.swp

# Ignore test coverage reports
htmlcov/
.coverage
.cache/
.pytest_cache/

# Ignore Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Ignore migrations if using Django or similar
migrations/